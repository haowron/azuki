# TrackEverything runtime configuration.
#
# Copy to .env and fill in your real values:
#   cp .env.example .env
#
# .env is gitignored (never committed). scripts/run_local.sh and compose (db) load it.
# Only the keys for sources you actually subscribe to are required; leave the
# rest blank. At least ONE LLM provider key must be set or startup will abort.

# ============================================================================
# LLM providers — priority: ZAI > DEEPSEEK > OPENAI
# If BOTH ZAI_API_KEY and DEEPSEEK_API_KEY are set, Z.AI is primary and
# DeepSeek is an automatic runtime fallback (429/5xx/network errors fail over).
# ZAI_API_KEY also authenticates the investigation CLIs (claude via the
# Anthropic-compatible endpoint set by scripts/run_local.sh; pi via the
# startup-generated model config) — no separate key.
# ============================================================================
ZAI_API_KEY=

DEEPSEEK_API_KEY=

OPENAI_API_KEY=

# Provider endpoints/models, LLM timeout, and LLM concurrency are application
# policy in src/trackeverything/config.py. They are intentionally not .env
# settings.

# Codex ImplementationAgent. These defaults take precedence over the Codex user configuration.
# IMPLEMENTATOR_MODEL=gpt-6.1-sol
# IMPLEMENTATOR_REASONING_EFFORT=xhigh
# Web search (Codex live search) model and reasoning effort (defaults: IMPLEMENTATOR_MODEL / medium).
# WEB_SEARCH_MODEL=gpt-6.1-sol
# WEB_SEARCH_REASONING_EFFORT=medium
# fast and a one-off reasoning_effort are specified in the agent request.

# ============================================================================
# Database — memory, sessions, and the execution log live in the
# PostgreSQL `db` service (docker-compose.yml). Only the password normally
# needs changing; the whole URL can be overridden with TE_DATABASE_URL. If you
# change POSTGRES_PASSWORD here, TE_DATABASE_URL's embedded password must match
# (or override it too).
# ============================================================================
# POSTGRES_PASSWORD=trackeverything
# TE_DATABASE_URL=postgresql://trackeverything:trackeverything@127.0.0.1:5432/trackeverything

# Components (agents, tools, skills, harnesses, Sources) live in git. Without COMPONENT_REPO_URL (local mode) the
# runtime's bare mirror holds main, seeded from the package's defaults, and is cloned into components/ for editing.
# With it, the runtime adopts that repository's GitHub main every COMPONENT_FETCH_INTERVAL seconds and the optimizer
# pushes its repairs with the deploy key.
# COMPONENT_REPO_URL=git@github.com:<owner>/<component-repository>.git
# COMPONENT_REPO_DIR=/absolute/path/to/data/components.git
# COMPONENTS_DIR=/absolute/path/to/components
# COMPONENT_REPO_SSH_KEY=/absolute/path/to/deploy_key
# COMPONENT_FETCH_INTERVAL=300

# Python agent skills. When unset, skills/ of each component version is used. An explicit value replaces the whole root.
# SKILLS_DIR=/absolute/path/to/skills

# ============================================================================
# Source credentials — set only the ones your Source runs use.
#    source                          →  env var needed
#    github_pull_request             →  GITHUB_TOKEN (optional for public repos)
#    notion_page                     →  NOTION_TOKEN (required)
#    apidog_api                      →  APIDOG_ACCESS_TOKEN (required)
#    slack_channel                   →  SLACK_TOKEN (required)
# ============================================================================
GITHUB_TOKEN=
NOTION_TOKEN=
APIDOG_ACCESS_TOKEN=
SLACK_TOKEN=
# Slack Socket Mode intake. Publishes posts in the target channel in raw form. Without an app token, the connection is skipped.
# App-Level scope: connections:write. User scopes: channels:history, channels:read, users:read.
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=

# ============================================================================
# Webhook ingress — POST /webhook/github and /webhook/slack queue the raw event
# for the dispatch Agent. The app listens on WEBHOOK_PORT
# (run_local.sh default 18080; the shared gateway owns 8080).
# Optional shared secret: when set, every POST /webhook/* must send the same
# value in the X-Webhook-Token header. Empty = no auth.
WEBHOOK_TOKEN=
# Listen address and port of the queue process (scripts/run_local.sh defaults the port to 18080).
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=18080

# Shared HTML for PR reviews. Set an HTTPS URL that includes the public prefix and /reports.
# When unset, a short publish-failure notice is sent and the review result itself is kept.
REPORTS_BASE_URL=
# Where reports are saved (default: data/review-reports in the running checkout).
# REPORTS_DIR=/path/to/data/review-reports
# Work docs store (default: data/docs in the running checkout) and the issue repository that number-only references point to.
# DOCS_DIR=/path/to/data/docs
# DOCS_ISSUE_REPO=example-org/issues
# Parent directories of local clones that the issue spec step offers as candidates (":"-separated). Empty: none.
# LOCAL_REPOSITORY_ROOTS=~/src:~/work
# Other runtime paths (defaults under data/ in the running checkout): the recipient profile and the repo catalog
# (create them from data/*.example.md), disposable per-repo clones for investigations, project documents
# (default: <DOCS_DIR>/projects), and the conversation-to-investigation-CLI session mapping.
# ROLE_PATH=/path/to/data/role.md
# REPO_CATALOG_PATH=/path/to/data/repo-catalog.md
# REPOS_DIR=/path/to/data/repos
# PROJECTS_DIR=/path/to/data/docs/projects
# HITL_DIR=/path/to/data/hitl

# Cloudflare Tunnel (optional). Get the token from Cloudflare's Tunnel creation page.
# cloudflared runs on the host. Setup and startup: docs/CONFIGURATION.md#cloudflare-tunnel
# When exposing the app publicly, also set WEBHOOK_TOKEN.
CLOUDFLARE_TUNNEL_TOKEN=

# Discord: the Gateway starts only when a bot token is set.
# Enable the Message Content Intent in the Developer Portal.
# ALLOWED_USER_ID is the owner's Discord user ID whose messages are accepted.
# NOTIFY_CHANNEL is the optional default notification destination (text channel / thread ID).
# The notify tool also delivers through Discord (log only when the token or the destination is missing).
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
DISCORD_NOTIFY_CHANNEL=
# Channel that accepts issue URLs. Empty means NOTIFY_CHANNEL. After creation, the owner starts work in the new channel.
DISCORD_GENERAL_CHANNEL=
# Server (guild) where classify_prs creates PR channels. When unset, it is derived from NOTIFY_CHANNEL.
DISCORD_GUILD_ID=
# Reviewer login that classify_prs registers at the review entrance (the owner's GitHub account).
# The same login is used for webhook review_requested and own-PR comment checks.
CLASSIFY_REVIEWER_LOGIN=
# PR review targets (comma-separated owner/repo; empty: nothing is reviewed) and the reviewer skill directory
# (default: claude/skills/reviewer in the running checkout).
REVIEW_REPOSITORIES=
# Routine operations on own PRs in REVIEW_REPOSITORIES: the reviewer requested on Ready for review (empty: no request), and a
# case-insensitive regular expression of check names whose failures do not stop the squash merge after approval (empty: none).
PR_AUTOMATION_REVIEWER=
PR_AUTOMATION_IGNORED_CHECKS=
# REVIEW_SKILL_PATH=/path/to/claude/skills/reviewer
# Extra read-only material for the reviewer (":"-separated; default: data/review/knowledge).
# REVIEW_KNOWLEDGE_PATHS=/path/to/data/review/knowledge
# Read-only DB offered to the reviewer for evidence queries (empty: disabled).
# REVIEW_DB_DSN=mysql://user:pass@host:3306/example_db?charset=utf8mb4
# Claude Code CLI used by review and code_fix.
# REVIEW_CLI_PATH=claude
# Review bots whose comments and reviews on own PRs are announced in the PR channel (comma-separated).
# REVIEW_BOT_LOGINS=coderabbitai[bot]
# PR watch: maximum number of comments per API in the comment window.
# WATCH_COMMENT_WINDOW=100
# Author of the commits created by code_fix and Sentry fixes (defaults: track-everything / track-everything@localhost).
# FIX_COMMIT_NAME=track-everything
# FIX_COMMIT_EMAIL=you@example.com
# Repositories code_fix may modify (comma-separated owner/repo; default: REVIEW_REPOSITORIES), its run limit in seconds,
# and how long a pending fix waits for confirmation in seconds.
# FIX_ALLOWED_REPOS=example-org/example-api
# FIX_TIMEOUT=1800
# FIX_PENDING_TTL=86400
# Allowlist of workflow names for the ci_failure entrance (workflow_run failure handling).
# Comma-separated. Empty (the default) handles failures of every workflow.
CI_FAILURE_WORKFLOWS=

# ============================================================================
# Investigation credentials (read-only, optional) — not consumed by the app's sources.
# run_local.sh exports every .env key, and the Host base tool bash runs its commands with that full environment.
# ============================================================================
# Optional component: Sentry auto-fix (docs/EXTENSIONS.md#scheduled-components). Values are literal single lines; do not quote JSON.
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_REPOSITORY=
SENTRY_BRANCH=
# SENTRY_SERVER_HOST_PATTERN=ip-[0-9-]+\.[a-z0-9-]+\.compute\.internal
# SENTRY_API_HOST_PATTERN=(?:[a-z0-9-]+[.-])?api\.example\.com
SENTRY_ISSUE_REPOSITORY=
# SENTRY_ISSUE_LABEL=bug
# SENTRY_GITHUB_PROJECT_OWNER=example-org
# SENTRY_GITHUB_PROJECT_NUMBER=3
# SENTRY_GITHUB_PROJECT_ID=PVT_xxxxxxxxxxxx
# SENTRY_GITHUB_PROJECT_FIELDS=[["PVTSSF_xxxx","1a2b3c4d"]]
# SENTRY_CLIENT_REPOS=[{"name":"example-ios","repository":"example-org/example-ios","branch":"main","apps":["example-ios"],"hosts":[]}]
SENTRY_ALLOWED_ROOTS=
SENTRY_DB_CONTAINER=
# SENTRY_COMPOSE_PROJECT=example-api
# SENTRY_PR_FOOTER=API tests\n- [ ] skipped
# SENTRY_REPO_CONTEXT_PATH=data/sentry-repo-context.md
# Read-only production replica for the triage's data angle (used by sentry_triage_cli).
# SENTRY_TRIAGE_DB_DSN=mysql://user:pass@host:3306/example_db?charset=utf8mb4
DD_SITE=
DD_BEARER_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
# Read-only AWS investigation uses the readonly profile in ~/.aws (passed with --profile).
# Write keys are intentionally not stored.

# Redis queue. Dev and the always-on environment separate both the DB and the namespace.
QUEUE_REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAMESPACE=trackeverything
RUN_CONCURRENCY=20
# Cancel a run of the entrance after this many seconds (default 3600).
# RUN_TIMEOUT=3600
# Minimum seconds between the sweeps that retire the channels of closed PRs.
# PR_RETIRE_SWEEP_INTERVAL=3600
TE_REDIS_PORT=6379
TE_REDIS_MAXMEMORY=512mb
